modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "imagemagick", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "p7zip", "tcl", "tk", "unrar", "unzip", "which", "zip", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord API Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vite --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Discord API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 3001

[[ports]]
localPort = 1104

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 3001

[[ports]]
localPort = 5001
externalPort = 3000

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npx vite build"]
run = ["node", "server.prod.js"]
publicDir = "dist/public"

[userenv]

[userenv.shared]
DISCORD_GUILD_ID = "1335136143112671296"
DISCORD_CHANNEL_ID = "1470521372932313283"
DISCORD_PUBLIC_KEY = "65ab393578552762221adb5c8068533f8819b371605b0723966764c3ad0d125f"
