# ════════════════════════════════════════════════════════════════
# GRUDGE WARS — Environment Variables
# Copy to .env for local development
# ════════════════════════════════════════════════════════════════

# Auth (login, register, OAuth, JWT)
VITE_AUTH_URL=https://id.grudge-studio.com

# Game API (economy, crafting, combat, islands, missions, crews, PvP)
VITE_API_URL=https://api.grudge-studio.com

# Account API (profiles, social, achievements)
VITE_ACCOUNT_URL=https://account.grudge-studio.com

# WebSocket (real-time: /game, /crew, /global, /pvp)
VITE_WS_URL=wss://ws.grudge-studio.com

# Launcher API (patch manifest, version gating)
VITE_LAUNCHER_URL=https://launcher.grudge-studio.com

# Assets CDN (textures, models, audio, sprites)
VITE_ASSETS_URL=https://assets.grudge-studio.com

# Static game data (weapons, armor, races, classes, factions)
VITE_OBJECTSTORE_URL=https://molochdagod.github.io/ObjectStore/api/v1

# ════════════════════════════════════════════════════════════════
# ── SERVER (server.js) — set these in your VPS environment or Vercel project settings
# ════════════════════════════════════════════════════════════════

# JWT signing secret — REQUIRED, server throws on boot if missing
JWT_SECRET=

# Grudge backend overrides (default to production if not set)
GRUDGE_API_URL=https://api.grudge-studio.com
GRUDGE_AUTH_URL=https://id.grudge-studio.com
GRUDGE_ACCOUNT_URL=https://account.grudge-studio.com

# MetaMask Embedded Wallets (optional — enhances wallet JWT verification)
WEB3_JWKS_Endpoint=
WEB3_Client_ID=
WEB3_AUTH_CLIENT_SECRET=

# Discord OAuth (required for Discord login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GRUDGE_WEBHOOK=

# Admin API token (used by /api/db/* and /api/discord/webhook/* routes)
GAME_API_GRUDA=

# Crossmint (optional — auto-creates Solana wallets for new accounts)
CROSSMINT_SERVER_API_KEY=

# Public URL (used to build OAuth redirect URIs; auto-detected if not set)
PUBLIC_URL=https://grudgewarlords.com

# ════════════════════════════════════════════════════════════════
# DO NOT ADD:
# - DATABASE_URL or GRUDGE_ACCOUNT_DB (Neon is decommissioned)
# - SUPABASE_URL / SUPABASE_KEY (not used)
# - Any secrets committed to git (use Vercel/VPS env dashboard)
# ════════════════════════════════════════════════════════════════
