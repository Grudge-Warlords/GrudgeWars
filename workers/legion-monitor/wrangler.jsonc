{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "legion-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-04-17",
  "observability": { "enabled": true },

  // KV namespace — create with: wrangler kv namespace create LEGION_KV
  // Then paste the ID below
  "kv_namespaces": [
    {
      "binding": "LEGION_KV",
      "id": "8b317f3bb7b641ee81025579f01f5aa4"
    }
  ],

  // Cron: health-check all deployments every 5 minutes
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Secrets (set via: wrangler secret put DISCORD_WEBHOOK)
  //   DISCORD_WEBHOOK  — Discord webhook URL for alerts
  //   ADMIN_TOKEN      — same as GAME_API_GRUDA token for /errors endpoint

  "env": {
    "production": {
      "name": "legion-monitor",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
